/*
    Helpful repo: https://github.com/bmijanovich/zmk-config/blob/main/config/glove80.keymap
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define L_NUM_AND_SYM 1
#define L_FN_AND_KB   2
#define L_BT          3


#define TAPPING_TERM         200
#define TAPPING_TERM_PER_KEY
#define TAP_DANCE_TIMEOUT_MS 200

#define MT_TAPPING_TERM 180

#define HYPER LC(LA(LS(LGUI)))
#define MEH   LC(LA(LEFT_SHIFT))

&caps_word {
    continue-list = <UNDERSCORE MINUS LSHFT RSHFT>;
};

&lt {
   // retro-tap; // https://zmk.dev/docs/keymaps/behaviors/hold-tap#retro-tap
   flavor = "hold-preferred";
};

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <TAPPING_TERM>;
    require-prior-idle-ms = <200>; 
};

/ {
    behaviors {
        // press once for caps word, twich for caps lock
        td_caps: tap_dance_capsw_capsl { 
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_DANCE_TIMEOUT_MS>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            require-prior-idle-ms = <125>; // lifesaver
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer: base_layer {
            display-name = "Base";
            bindings = <
                &kp TAB    &kp Q        &kp W        &kp E        &kp R       &kp T        &kp Y  &kp U       &kp I       &kp O        &kp P                &kp BSPC
                &td_caps   &hm LSHFT A  &hm LCTRL S  &hm LALT D   &hm LGUI F  &kp G        &kp H  &hm RGUI J  &hm RALT K  &hm RCTRL L  &hm RSHFT SEMICOLON  &kp SQT
                &kp GRAVE  &kp Z        &kp X        &kp C        &kp V       &kp B        &kp N  &kp M       &kp COMMA   &kp DOT      &kp BSLH             &kp FSLH

                       &kp GLOBE   &kp ESC   &mt HYPER SPACE                                    &lt L_NUM_AND_SYM RET   &lt L_FN_AND_KB LC(BSLH)   &kp MEH
            >;
        };

        lower_layer: lower_layer {
            display-name = "Num Sym";
            bindings = <
                &trans    &kp EXCLAMATION    &kp AT_SIGN         &kp HASH           &kp DOLLAR         &kp PERCENT             &kp CARET          &kp AMPERSAND     &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
                &trans    &hm LSHFT NUMBER_1 &hm LCTRL NUMBER_2  &hm LALT NUMBER_3  &hm LGUI NUMBER_4  &kp NUMBER_5            &kp NUMBER_6       &hm RGUI NUMBER_7 &hm RALT NUMBER_8 &hm RCTRL NUMBER_9    &hm RSHFT NUMBER_0     &trans
                &trans    &none              &kp UP_ARROW        &kp DOWN_ARROW     &kp MINUS          &kp LEFT_BRACKET        &kp RIGHT_BRACKET  &kp EQUAL         &kp LEFT_ARROW    &kp RIGHT             &none                  &trans

                                             &trans        &trans          &trans                                                    &trans   &trans   &trans
            >;
        };

        raise_layer: raise_layer {
            display-name = "Fn";
            bindings = <
                &kp C_BRIGHTNESS_INC &none      &none       &none         &none        &none             &none        &none        &none        &none    &none    &kp C_VOLUME_UP
                &kp C_BRIGHTNESS_DEC &kp F1     &kp F2      &kp F3        &kp F4       &kp F5            &kp F6       &kp F7       &kp F8       &kp F9   &kp F10  &kp C_VOLUME_DOWN
                &kp PRINTSCREEN      &kp DELETE &kp PAGE_UP &kp PAGE_DOWN &kp INSERT   &kp F11           &kp F12      &none        &kp HOME     &kp END  &none    &kp K_MUTE

                                                            &trans        &mo L_BT     &out OUT_TOG      &none        &none        &none
            >;
        };

        
        bt_layer: bt_layer {
            display-name = "Bt";
            bindings = <
                &none          &none        &none        &none        &none        &none            &none &none       &none       &none &none &none
                &bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &none &bt BT_NXT &bt BT_PRV   &none &none &none
                &bt BT_CLR_ALL &none        &none        &none        &none        &none            &none &none       &none       &none &none &none

                                            &none        &none        &none                               &none       &none       &none
            >;
        };

        
    };
};
